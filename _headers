# Cloudflare Pages reads this file. Harmless anywhere else — delete it if the
# site ends up on GitHub Pages, which ignores it.
#
# The font filenames are stable, so they need an explicit long cache. If you
# ever replace a font file, rename it too, or returning visitors keep the old one.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable


/og.png
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=3600
