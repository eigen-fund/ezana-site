# Netlify and Cloudflare Pages both read this file from the publish directory.
# GitHub Pages ignores it, so delete it if the site ever moves there.
#
# The font filenames are stable, so they need an explicit long cache. If you
# ever replace a font file, rename it too, or returning visitors keep the old one.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable


/og.png
  Cache-Control: public, max-age=604800

# HTML must always revalidate, or a visitor can be served a page from before
# the last deploy and neither of you would know. This is what Netlify does by
# default; the rule exists to apply it to every page rather than leaving the
# ones this file matches on a one-hour TTL.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
